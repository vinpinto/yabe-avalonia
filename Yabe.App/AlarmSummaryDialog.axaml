<Window xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Yabe.AlarmSummaryDialog"
 Title="Active Alarms on Device"
 Width="460" Height="460"
 WindowStartupLocation="CenterOwner"
 CanResize="False">

 <DockPanel Margin="12,8,12,12">
 <!-- Top: label + refresh -->
 <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
 <TextBlock Text="Key F4 to refresh" VerticalAlignment="Center" />
 <Button x:Name="btnRefresh" Content="Refresh" Height="22" Padding="8,0" />
 </StackPanel>

 <!-- Bottom: Ack button + Ack text -->
 <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
 <Button x:Name="btnAck" Content="Ack selected alarm(s)" IsEnabled="False"
 Height="23" />
 <TextBox x:Name="txtAck" Width="155" Text="Ack by Yabe" IsEnabled="False" />
 </StackPanel>

 <!-- TreeView with overlay info -->
 <Panel>
 <TreeView x:Name="treeAlarms" />
 <TextBlock x:Name="lblInfo" Text="Loading alarms, please wait ..."
 HorizontalAlignment="Center" VerticalAlignment="Center"
 IsVisible="True" />
 </Panel>
 </DockPanel>
</Window>
