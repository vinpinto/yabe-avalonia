<Window xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Yabe.FileTransferDialog"
 Title="BACnet File Transfer"
 Width="500" Height="280"
 WindowStartupLocation="CenterOwner"
 CanResize="False"
 FontSize="11">

 <StackPanel Margin="16" Spacing="8">
 <TextBlock x:Name="lblTitle" Text="File Transfer" FontWeight="Bold" />

 <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
 <TextBlock Grid.Row="0" Grid.Column="0" Text="File Object:" VerticalAlignment="Center"
 Margin="0,0,8,4" />
 <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtFileObject"
 IsReadOnly="True" Margin="0,0,0,4" />

 <TextBlock Grid.Row="1" Grid.Column="0" Text="Local Path:" VerticalAlignment="Center"
 Margin="0,0,8,0" />
 <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtLocalPath" />
 <Button Grid.Row="1" Grid.Column="2" x:Name="btnBrowse" Content="..."
 Width="32" Margin="4,0,0,0" />
 </Grid>

 <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
 <Button x:Name="btnStart" Content="Start Transfer" Height="23" />
 <Button x:Name="btnCancel" Content="Close" Height="23" />
 </StackPanel>

 <ProgressBar x:Name="pbProgress" Minimum="0" Maximum="100" Value="0" Height="20" />
 <TextBlock x:Name="lblStatus" Text="Ready" Foreground="Gray" />
 </StackPanel>
</Window>
