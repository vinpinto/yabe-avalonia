<Window xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Yabe.GenericInputBox"
 Title="Input"
 Width="320" Height="180"
 WindowStartupLocation="CenterOwner"
 CanResize="False">

 <StackPanel Margin="16" Spacing="8">
 <TextBlock x:Name="lblPrompt" Text="Value:" />
 <TextBox x:Name="txtInput" Width="260" HorizontalAlignment="Left" />
 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
 <Button x:Name="btnOk" Content="OK" Width="80" IsDefault="True" />
 <Button x:Name="btnCancel" Content="Cancel" Width="80" IsCancel="True" />
 </StackPanel>
 </StackPanel>
</Window>
