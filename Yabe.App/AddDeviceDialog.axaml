<Window xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Yabe.AddDeviceDialog"
 Title="BACnet Communication Channel"
 Width="860" Height="360"
 WindowStartupLocation="CenterOwner"
 CanResize="False"
 FontSize="11">

 <DockPanel Margin="6">

 <!-- Top: General settings row -->
 <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" CornerRadius="2"
  Margin="0,0,0,4" Padding="6,4">
  <DockPanel>
   <TextBlock Text="General" FontWeight="Bold" DockPanel.Dock="Left"
    VerticalAlignment="Center" Margin="0,0,10,0" />
   <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <TextBlock Text="Retries" VerticalAlignment="Center" />
    <NumericUpDown x:Name="nudRetries" Value="1" Minimum="0" Maximum="10" Width="100"
     FormatString="0" />
    <TextBlock Text="Timeout" VerticalAlignment="Center" />
    <NumericUpDown x:Name="nudTimeout" Value="500" Minimum="100" Maximum="60000" Width="110"
     FormatString="0" />
    <TextBlock Text="WhoIs limit low" VerticalAlignment="Center" />
    <TextBox x:Name="txtWhoIsLow" Text="" Width="70" />
    <TextBlock Text="high" VerticalAlignment="Center" />
    <TextBox x:Name="txtWhoIsHigh" Text="" Width="70" />
    <CheckBox x:Name="chkSendWhoIs" Content="Send WhoIs" IsChecked="True"
     VerticalAlignment="Center" />
   </StackPanel>
  </DockPanel>
 </Border>

 <!-- Two-column layout -->
 <Grid ColumnDefinitions="*,6,*">

  <!-- Left column -->
  <StackPanel Grid.Column="0" Spacing="4">

   <!-- BACnet/IP V4 & V6 over Udp -->
   <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="6,4">
    <StackPanel Spacing="4">
     <TextBlock Text="BACnet/IP V4 &amp; V6 over Udp" FontWeight="Bold" />
     <Grid ColumnDefinitions="80,*,8,65" RowDefinitions="Auto,Auto">
      <TextBlock Text="Port" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="txtPortHex" Text="BAC0" />
      <NumericUpDown x:Name="nudPort" Value="47808" IsVisible="False" />
      <Button Grid.Column="3" x:Name="btnAddIp" Content="Start" HorizontalAlignment="Stretch"
       HorizontalContentAlignment="Center" />
      <TextBlock Grid.Row="1" Text="Local endpoint" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
       x:Name="cmbLocalEndpoint" HorizontalAlignment="Stretch" />
     </Grid>
    </StackPanel>
   </Border>

   <!-- BACnet/Secure Connect over Websocket -->
   <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="6,4">
    <StackPanel Spacing="3">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="BACnet/Secure Connect over Websocket" FontWeight="Bold"
       VerticalAlignment="Center" />
      <Button x:Name="btnAddSC" Content="Start" Width="60"
       HorizontalContentAlignment="Center" />
     </StackPanel>
     <TextBlock Text="Configuration parameters File :" />
     <TextBox x:Name="txtScConfig" IsReadOnly="True" />
     <StackPanel Orientation="Horizontal" Spacing="6">
      <Button x:Name="btnScSelect" Content="Select" Width="60"
       HorizontalContentAlignment="Center" />
      <Button x:Name="btnScEdit" Content="Edit" Width="60"
       HorizontalContentAlignment="Center" />
     </StackPanel>
    </StackPanel>
   </Border>

   <!-- BACnet/Ethernet -->
   <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="6,4">
    <StackPanel Spacing="3">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="BACnet/Ethernet" FontWeight="Bold" VerticalAlignment="Center" />
      <Button x:Name="btnAddEthernet" Content="Start" Width="60"
       HorizontalContentAlignment="Center" />
     </StackPanel>
     <Grid ColumnDefinitions="70,*">
      <TextBlock Text="Interface" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="cmbEthernetInterface" HorizontalAlignment="Stretch" />
     </Grid>
    </StackPanel>
   </Border>

  </StackPanel>

  <!-- Right column -->
  <StackPanel Grid.Column="2" Spacing="4">

   <!-- BACnet/MSTP over serial -->
   <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="6,4">
    <StackPanel Spacing="3">
     <TextBlock Text="BACnet/MSTP over serial" FontWeight="Bold" />
     <Grid ColumnDefinitions="90,*,8,65" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <TextBlock Text="Port" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="cmbSerialPort" HorizontalAlignment="Stretch" />
      <Button Grid.Column="3" x:Name="btnAddMstp" Content="Start"
       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      <TextBlock Grid.Row="1" Text="Baud" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="nudBaud" Value="38400"
       Minimum="9600" Maximum="115200" FormatString="0" />
      <TextBlock Grid.Row="2" Text="Source Address" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="nudSourceAddr" Value="-1"
       Minimum="-1" Maximum="254" FormatString="0" />
      <TextBlock Grid.Row="3" Text="Max Master" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="nudMaxMaster" Value="127"
       Minimum="1" Maximum="127" FormatString="0" />
      <TextBlock Grid.Row="4" Text="Max Frames" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="nudMaxFrames" Value="1"
       Minimum="1" Maximum="255" FormatString="0" />
     </Grid>
    </StackPanel>
   </Border>

   <!-- BACnet/PTP over serial -->
   <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="6,4">
    <StackPanel Spacing="3">
     <TextBlock Text="BACnet/PTP over serial" FontWeight="Bold" />
     <Grid ColumnDefinitions="90,*,8,65" RowDefinitions="Auto,Auto,Auto">
      <TextBlock Text="Port" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="cmbPtpPort" HorizontalAlignment="Stretch" />
      <Button Grid.Column="3" x:Name="btnAddPtp" Content="Start"
       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      <TextBlock Grid.Row="1" Text="Baud" VerticalAlignment="Center" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="nudPtpBaud" Value="38400"
       Minimum="9600" Maximum="115200" FormatString="0" />
      <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtPtpPassword" PasswordChar="*" />
     </Grid>
    </StackPanel>
   </Border>

  </StackPanel>

 </Grid>
 </DockPanel>
</Window>
