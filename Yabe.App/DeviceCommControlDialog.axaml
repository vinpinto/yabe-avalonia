<Window xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Yabe.DeviceCommControlDialog"
 Title="Device Communication Control"
 Width="310" Height="360"
 WindowStartupLocation="CenterOwner"
 CanResize="False"
 FontSize="11">

 <StackPanel Margin="12" Spacing="6">

 <!-- Action GroupBox -->
 <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="8,4,8,8">
 <StackPanel>
 <TextBlock Text="Action" FontWeight="Bold" Margin="0,0,0,4" />
 <RadioButton x:Name="rbReinitialize" Content="Reinitialize" IsChecked="True"
 GroupName="Mode" Margin="20,0,0,2" />
 <RadioButton x:Name="rbCommControl" Content="Communication"
 GroupName="Mode" Margin="20,0,0,0" />
 </StackPanel>
 </Border>

 <!-- Reinitialize GroupBox -->
 <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="8,4,8,8">
 <StackPanel>
 <TextBlock Text="Reinitialize" FontWeight="Bold" Margin="0,0,0,4" />
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Text="State" VerticalAlignment="Center" Width="50" />
 <ComboBox x:Name="cmbState" Width="150" />
 </StackPanel>
 </StackPanel>
 </Border>

 <!-- Communication GroupBox -->
 <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="8,4,8,8">
 <StackPanel>
 <TextBlock Text="Communication" FontWeight="Bold" Margin="0,0,0,4" />
 <CheckBox x:Name="chkDisable" Content="Disable" IsChecked="True"
 Margin="40,0,0,4" />
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Text="Duration (minutes)" VerticalAlignment="Center" />
 <NumericUpDown x:Name="nudDuration" Value="0" Minimum="0" Maximum="65535"
 Width="110" FormatString="0" />
 </StackPanel>
 </StackPanel>
 </Border>

 <!-- Optional GroupBox -->
 <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="8,4,8,8">
 <StackPanel>
 <TextBlock Text="Optional" FontWeight="Bold" Margin="0,0,0,4" />
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Text="Password" VerticalAlignment="Center" Width="60" />
 <TextBox x:Name="txtPassword" Width="150" PasswordChar="*" />
 </StackPanel>
 </StackPanel>
 </Border>

 <!-- OK / Cancel at bottom-right -->
 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
 <Button x:Name="btnOk" Content="OK" Width="56" Height="23" />
 <Button x:Name="btnCancel" Content="Cancel" Width="56" Height="23" />
 </StackPanel>
 </StackPanel>
</Window>
