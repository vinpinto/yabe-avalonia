<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <RootNamespace>Yabe</RootNamespace>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/Search.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Desktop: WinExe output -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!-- Common Avalonia packages -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.7" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.7" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.0.55" />
  </ItemGroup>

  <!-- Desktop-only packages -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
  </ItemGroup>

  <!-- Android-only packages -->
  <ItemGroup Condition="$(TargetFramework.Contains('android'))">
    <PackageReference Include="Avalonia.Android" Version="11.2.7" />
  </ItemGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('android'))">
    <DefineConstants>$(DefineConstants);ANDROID_BUILD</DefineConstants>
  </PropertyGroup>

  <!-- Exclude desktop entry point for Android -->
  <ItemGroup Condition="$(TargetFramework.Contains('android'))">
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yabe.Core\Yabe.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
